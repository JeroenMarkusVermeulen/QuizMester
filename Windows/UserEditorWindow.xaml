<Window x:Class="Quizmester.Windows.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gebruiker toevoegen" Height="470" Width="500" ResizeMode="NoResize">
    <Grid Margin="35">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="30">
            <StackPanel>
                <TextBlock Text="Gebruiker toevoegen" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Gebruikersnaam" Margin="0,18,0,0"/>
                <TextBox x:Name="UsernameBox"/>
                <TextBlock Text="Wachtwoord"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="Rol"/>
                <ComboBox x:Name="RoleCombo">
                    <ComboBoxItem Content="User" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Toevoegen" Click="Save_Click" Width="130"/>
                    <Button Content="Annuleren" Click="Cancel_Click" Background="#475569" Width="130"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
