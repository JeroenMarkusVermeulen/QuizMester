<Window x:Class="Quizmester.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registreren" Height="500" Width="470" ResizeMode="NoResize">
    <Grid Margin="35">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="30">
            <StackPanel>
                <TextBlock Text="Account maken" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Kies een unieke gebruikersnaam." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,20"/>

                <TextBlock Text="Gebruikersnaam"/>
                <TextBox x:Name="UsernameBox"/>
                <TextBlock Text="Wachtwoord"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="Herhaal wachtwoord"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button Content="Registreren" Click="Register_Click" Height="46"/>
                <Button Content="Annuleren" Click="Cancel_Click" Background="#334155" Height="44"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
