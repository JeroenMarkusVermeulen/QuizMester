<Window x:Class="Quizmester.Windows.ScoreboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top 10" Height="600" Width="700" ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="🏆 TOP 10" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
        <DataGrid x:Name="ScoreGrid" Grid.Row="1" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="60"/>
                <DataGridTextColumn Header="Gebruikersnaam" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120"/>
                <DataGridTextColumn Header="Gespeeld" Binding="{Binding PlayedAt, StringFormat=dd-MM-yyyy HH:mm}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Sluiten" Click="Close_Click" HorizontalAlignment="Right" Width="130" Margin="0,18,0,0" Background="#475569"/>
    </Grid>
</Window>
