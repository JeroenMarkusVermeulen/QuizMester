<Window x:Class="Quizmester.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quizmester Admin" Height="720" Width="1050" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="⚙ ADMIN PANEL" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Beheer quizvragen en gebruikersaccounts." Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,22,0,18" Background="{StaticResource PanelBrush}" Foreground="Black">
            <TabItem Header="Vragen">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="QuestionGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Categorie" Binding="{Binding CategoryName}" Width="140"/>
                            <DataGridTextColumn Header="Vraag" Binding="{Binding QuestionText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Vraag toevoegen" Click="AddQuestion_Click"/>
                        <Button Content="Bewerken" Click="EditQuestion_Click" Background="#0369A1"/>
                        <Button Content="Verwijderen" Click="DeleteQuestion_Click" Background="#B91C1C"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Gebruikers">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="UserGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Gebruikersnaam" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Gebruiker toevoegen" Click="AddUser_Click"/>
                        <Button Content="Gebruiker verwijderen" Click="DeleteUser_Click" Background="#B91C1C"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Sluiten" Click="Close_Click" HorizontalAlignment="Right" Width="130" Background="#475569"/>
    </Grid>
</Window>
