<Window x:Class="Quizmester.Windows.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kies een quiz" Height="510" Width="620" ResizeMode="NoResize">
    <Grid Margin="35">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="35">
            <StackPanel>
                <TextBlock Text="Kies je quiz" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="General bevat alle vragen. Een categorie bevat minimaal 20 vragen." Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,25"/>

                <RadioButton x:Name="GeneralRadio" Content="🌍  General - alle vragen" GroupName="Category" IsChecked="True" Tag="General" FontSize="18" Margin="10" Foreground="White"/>
                <ItemsControl x:Name="CategoryItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}" Tag="{Binding}" GroupName="Category" FontSize="18" Margin="10" Foreground="White" Checked="CategoryRadio_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Start quiz" Click="Start_Click" Margin="0,25,0,0" Height="52"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
